#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_ROOT="$(cd -P "$SCRIPT_DIR/../.." && pwd)"
PROJECT_ROOT="$(cd -P "$APP_ROOT/.." && pwd)"
APP_SUPPORT_DIR="$HOME/Library/Application Support/RaizQA"
VENV_DIR="$APP_SUPPORT_DIR/venv"
LOG_FILE="$APP_SUPPORT_DIR/launcher.log"
STAMP_FILE="$VENV_DIR/.requirements-hash"
REQUIREMENTS_FILE="$PROJECT_ROOT/requirements.txt"


mkdir -p "$APP_SUPPORT_DIR"

log() {
    printf '%s\n' "$*" >> "$LOG_FILE"
}

alert_and_exit() {
    local message="$1"
    /usr/bin/osascript -e "display alert \"RaizQA\" message \"$message\" as critical" >/dev/null 2>&1 || true
    exit 1
}

python_is_compatible() {
    local candidate="$1"

    [[ -x "$candidate" ]] && \
        "$candidate" -c \
            'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' \
            >/dev/null 2>&1
}

pick_python() {
    if [[ -n "${RAIZQA_PYTHON:-}" ]] && python_is_compatible "$RAIZQA_PYTHON"; then
        printf '%s' "$RAIZQA_PYTHON"
        return 0
    fi

    local candidate
    for candidate in \
        "/opt/homebrew/bin/python3" \
        "/usr/local/bin/python3" \
        "/Library/Frameworks/Python.framework/Versions/Current/bin/python3"
    do
        if python_is_compatible "$candidate"; then
            printf '%s' "$candidate"
            return 0
        fi
    done

    if command -v python3 >/dev/null 2>&1; then
        candidate="$(command -v python3)"
        if python_is_compatible "$candidate"; then
            printf '%s' "$candidate"
            return 0
        fi
    fi

    return 1
}

if [[ ! -f "$PROJECT_ROOT/main.py" ]]; then
    alert_and_exit "No se encontró main.py junto al lanzador."
fi

PYTHON_BIN="$(pick_python || true)"
if [[ -z "$PYTHON_BIN" ]]; then
    alert_and_exit "No se encontró Python 3.10 o superior. Ejecuta nuevamente el instalador de RaizQA."
fi
PYTHON_VERSION="$("$PYTHON_BIN" -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')"

log "Iniciando RaizQA desde $PROJECT_ROOT"
log "Python: $PYTHON_BIN"
log "Versión de Python: $PYTHON_VERSION"

VENV_IS_COMPATIBLE=false
if python_is_compatible "$VENV_DIR/bin/python"; then
    VENV_IS_COMPATIBLE=true
fi

if [[ "$VENV_IS_COMPATIBLE" != true ]]; then
    if [[ -e "$VENV_DIR" ]]; then
        log "El entorno virtual existente es incompatible o está dañado; se reconstruirá"
        VENV_OPTION="--clear"
    else
        VENV_OPTION=""
    fi

    log "Creando entorno virtual en $VENV_DIR"
    if [[ -n "$VENV_OPTION" ]]; then
        "$PYTHON_BIN" -m venv "$VENV_OPTION" "$VENV_DIR" \
            >> "$LOG_FILE" 2>&1 \
            || alert_and_exit "No se pudo reconstruir el entorno virtual. Revisa el registro."
    else
        "$PYTHON_BIN" -m venv "$VENV_DIR" \
            >> "$LOG_FILE" 2>&1 \
            || alert_and_exit "No se pudo crear el entorno virtual. Revisa el registro."
    fi
fi

if [[ ! -f "$REQUIREMENTS_FILE" ]]; then
    alert_and_exit "No se encontró requirements.txt."
fi

REQUIREMENTS_HASH="$(shasum -a 256 "$REQUIREMENTS_FILE" | awk '{print $1}')"
INSTALLED_HASH="$(cat "$STAMP_FILE" 2>/dev/null || true)"

if [[ "$INSTALLED_HASH" != "$REQUIREMENTS_HASH" ]]; then
    log "Instalando dependencias"

    "$VENV_DIR/bin/python" -m pip install --upgrade pip setuptools wheel \
        >> "$LOG_FILE" 2>&1 \
        || alert_and_exit "No se pudo preparar pip. Revisa el registro."

    "$VENV_DIR/bin/python" -m pip install -r "$REQUIREMENTS_FILE" \
        >> "$LOG_FILE" 2>&1 \
        || alert_and_exit "No se pudieron instalar las dependencias. Revisa el registro."

    printf '%s' "$REQUIREMENTS_HASH" > "$STAMP_FILE"
fi

cd "$PROJECT_ROOT"
exec "$VENV_DIR/bin/python" "$PROJECT_ROOT/main.py" >> "$LOG_FILE" 2>&1
